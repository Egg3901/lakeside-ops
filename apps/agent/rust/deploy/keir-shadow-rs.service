[Unit]
Description=Keir 4.0 Rust harness shadow pass (read-only against the live operator)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/keir/bin/keir-shadow-rs --once
# Publish the pass to the ops dashboard report library (report-publish MCP, slug keir-4-shadow).
ExecStartPost=-/root/.hermes/node/bin/node /opt/keir/bin/keir-shadow-publish.mjs
EnvironmentFile=-/etc/keir-agent.env
Environment=RUST_LOG=info
WorkingDirectory=/var/lib/keir-operator/shadow-rs
StateDirectory=keir-operator/shadow-rs
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/keir-operator /root/.claude.json
ReadWritePaths=/var/lib/keir-operator/shadow-rs
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=2G
TimeoutStartSec=300
