#!/usr/bin/env bash
# Block pushes that fail the test suite or that would commit credentials.
set -e
cd "$(git rev-parse --show-toplevel)"
if git ls-files | grep -E '(^|/)[^/]*\.env$|(^|/)\.env' | grep -v '\.example$' >/dev/null; then echo "pre-push: an env file is tracked; remove it" >&2; exit 1; fi
npm test --silent >/tmp/lakeside-operator-prepush.log 2>&1 || { tail -30 /tmp/lakeside-operator-prepush.log >&2; echo "pre-push: tests failed" >&2; exit 1; }
