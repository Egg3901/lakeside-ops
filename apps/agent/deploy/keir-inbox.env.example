# Keir DM inbox (keir-inbox.service). Copy to /etc/keir-inbox.env, mode 0600.
# Shared with the ops dashboard, which proxies /api/keir/inbox/* with it.
KEIR_INBOX_ADMIN_TOKEN=
# Game bot API key (X-Bot-Token) for lookup and promo grants.
DISCORD_BOT_API_KEY=
GAME_API_URL=https://ahousedividedgame.com
KEIR_INBOX_PUBLIC_PORT=9766
KEIR_INBOX_ADMIN_PORT=9767
KEIR_PROMO_CAMPAIGN=itch-boost-2026-10
# 1 turns reward claims on. 0 records DMs and sends only the general hint.
KEIR_PROMO_ACTIVE=0
# Comma-separated Discord ids whose claims run the full check but are never paid.
KEIR_PROMO_TESTERS=
