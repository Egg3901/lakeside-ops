# /etc/keir-operator.env, root:root 0600. Never commit the real file.
KEIR_OPERATOR_ADMIN_TOKEN=replace-with-random-token
KEIR_OPERATOR_PORT=9765
# Optional overrides (defaults shown):
# Main activations use the ChatGPT subscription, fixed medium effort.
KEIR_QUICK_PROVIDER=codex:gpt-6.1-sol@medium
KEIR_WORKER_PROVIDER=codex:gpt-6.1-sol@medium
KEIR_DYNAMIC_EFFORT=0
# Optional Claude runner fallback model, only when explicitly selecting Claude.
# KEIR_MODEL=claude-opus-5-5
KEIR_WORKERS=6
# KEIR_MAX_INTAKE_PER_HOUR=4
# KEIR_CLOSE_GRACE_MINUTES=60
# KEIR_MAX_TURN_MINUTES=15
# KEIR_MAX_TOOL_ROUNDS=24
# KEIR_TASK_LIFETIME_HOURS=168
# KEIR_SCAN_EXCLUDE=<comma-separated channel ids not to watch>
# The model runs on the owner's Claude subscription via the claude CLI.
# Do not add an Anthropic API key here or to any Keir unit.

# Optional source-read interface experiment, combined retains the existing tools.
# focused adds read_files/search_files when evidence_batch is already granted.
# KEIR_SOURCE_READ_TOOLS=combined
