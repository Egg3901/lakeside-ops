[Unit]
Description=Keir shadow review (read-only ledger check for the ops dashboard)

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/keir/current/bin/keir-shadow.js 20 --json /var/lib/keir-operator/shadow.json
# Keir 3.0 shadow review beside the 2.x one during the soak (read-only).
Environment=KEIR_OWNER_ID=333052320252297216 KEIR_STAFF_IDS=565289871799746593
ExecStart=-/usr/bin/node /opt/keir/current/bin/keir-shadow3.js /var/lib/keir-operator/ledger.json --minutes 20 --json /var/lib/keir-operator/shadow3.json
StandardOutput=append:/var/lib/keir-operator/shadow-last.txt
MemoryMax=512M
