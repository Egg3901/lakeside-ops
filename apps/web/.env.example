# Ops dashboard — copy to .env and fill in real values.
# Never commit the real .env.

# ── Core ──────────────────────────────────────────────────────────
PORT=9724
HOST=0.0.0.0
NODE_ENV=production

# Tenant identity (overrides config/dashboard.yaml when set)
TENANT_NAME="My Studio"
TENANT_SHORT_NAME="MyStudio"
DASHBOARD_TITLE="Ops Dashboard"
PRIMARY_PROJECT_KEY=my-game
PUBLIC_BASE=https://ops.example.com

# Auth
# OPS_AUTH_MODE=password # use sso when an identity broker is configured
# EVENT_CONSUMER_ENABLED=false # disable stream consumption in a staging instance
OPS_PASSWORD_HASH=
OPS_SESSION_SECRET=
OPS_USERS="admin@example.com:admin:$2b$..."

# Database (no hardcoded DB name in code)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ops-dashboard
MONGODB_DIRECT_CONNECTION=true

# Paths (all configurable — never commit box-specific absolute defaults)
PROJECTS_ROOT=/var/projects
BACKUP_DIR=/var/backups
UPLOADS_DIR=/var/uploads
SKILLS_DIR=/opt/skills
HERMES_SKILLS_DIR=/opt/hermes/skills
HERMES_HOME_DIR=/opt/hermes
SANDBOX_DIR=./ahd-sandbox
# Finder allowlist: comma-separated abs paths, or JSON array of {id,label,path,kind}
# FINDER_ROOTS=/var/projects,/var/www
# OPS_SSO_HOSTS=ops.example.com

# Optional SSO (generic names; LAKESIDE_AUTH_* still accepted as aliases)
# Set OPS_AUTH_MODE=sso to disable password login and local sessions.
# Keep sessions and published reports outside immutable release directories.
# OPS_SESSIONS_FILE=/var/lib/ops-dashboard/sessions.json
# PUBLISHED_REPORTS_DIR=/var/lib/ops-dashboard/reports/published
SSO_BASE_URL=
SSO_INTERNAL_TOKEN=
# LAKESIDE_AUTH_BASE_URL=
# LAKESIDE_AUTH_INTERNAL_TOKEN=

# Optional upstreams
# RAILWAY_TOKEN=
# RAILWAY_PROJECT_ID=
# GLITCHTIP_API_URL=
# GLITCHTIP_AUTH_TOKEN=
# KUMA_STATUS_URL=
# OPENREPLAY_INGEST_POINT=
# SENTRY_DSN=

# Feature flags (override config/dashboard.yaml features.*)
ENABLE_STATUS_PAGE=true
ENABLE_CODE_AGENT=true
ENABLE_DISCORD_INSIGHTS=true
ENABLE_TICKETS=true
ENABLE_WIKI_EXPORT=true
ENABLE_BACKUPS=true
ENABLE_DB_BROWSER=true
ENABLE_IDEAS=true
ENABLE_AGENTS_PAGE=true
# Optional MCP public host (no trailing /mcp)
# MCP_PUBLIC_BASE=https://mcp.example.com

# Read-only bearer token letting codebase Q&A consult the MCP fleet (knowledge,
# live game state, engine, support). MUST be a read-scoped token: write tools are
# filtered out by scope at the MCP server, so the token is what keeps Ask
# read-only. Unset, Ask answers from source files alone, exactly as before.
# ASK_MCP_TOKEN=

# Branch the Q&A sandbox clone tracks. The AHD repo's default branch is released
# code, so answering from it silently lags whatever was just merged.
# SANDBOX_BRANCH=development

# Optional source-index maintenance scripts require both repository paths.
# RAG_GAME_REPO=/projects/game
# RAG_DOCS_REPO=/projects/docs

# ─── Model routing ──────────────────────────────────────────────────
# Sizing and provider health live in model-router.js; there is nothing to
# configure here. Two things worth knowing:
#   • Opus is denied platform-wide (model-router.js DENIED_MODELS) and is
#     unreachable from the picker, the API, and stored schedules alike. Claude
#     work tops out at Sonnet and buys depth through effort instead.
#   • A provider that returns 403 or 429 is benched for 30 minutes (or until its
#     reported reset), so an exhausted plan is not retried on every call.

# Knowledge store DB (defaults to MONGODB_DB_NAME / primary project integration)
# KNOWLEDGE_LEGACY_PROJECT=shared
# KNOWLEDGE_COLLECTION=ops_knowledge
